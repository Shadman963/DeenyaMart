# DeenyaMart Environment Configuration Example
# Copy to `.env` and set values in your environment before running in production.
# Never commit real secrets or API keys to version control.

DJANGO_SECRET_KEY=replace-with-a-cryptographically-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Store Currency (Explicitly validated during product imports)
STORE_CURRENCY_CODE=BDT
STORE_CURRENCY_SYMBOL=৳

# Product Import & Image Download Security Controls
IMPORT_DEFAULT_SOURCE_NAME=droploo
IMPORT_ALLOW_IMAGE_DOWNLOAD=False
IMPORT_ALLOWED_IMAGE_HOSTS=backend.droploo.com,droploo.com
IMPORT_IMAGE_TIMEOUT_SECONDS=10
IMPORT_MAX_IMAGE_BYTES=5242880

# Supplier API Credentials (Reserved for future authorized supplier integration;
# live API sync is disabled because droploo.com does not expose a verified public partner API)
DROPLOO_API_BASE_URL=
DROPLOO_API_KEY=
DROPLOO_API_SECRET=
DROPLOO_SYNC_ENABLED=False
